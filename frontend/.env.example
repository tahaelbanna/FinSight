# =============================================================================
# FinSight Frontend Environment Configuration Template (.env.example)
# Concept C: Modern FinTech / Editorial
# =============================================================================

# API Gateway Base URL
VITE_API_BASE_URL=/api/v1

# -----------------------------------------------------------------------------
# Microsoft Power BI Embedded Configuration (Public Client-Side Tokens Only)
# NOTE: Never place Azure client secrets or service principal passwords here.
# -----------------------------------------------------------------------------

# Power BI Workspace ID (from Microsoft Power BI Service)
VITE_POWER_BI_WORKSPACE_ID="00000000-0000-0000-0000-000000000000"

# Power BI Default Report ID (UUID)
VITE_POWER_BI_REPORT_ID="00000000-0000-0000-0000-000000000000"

# Power BI Secure Embed URL (app.powerbi.com)
VITE_POWER_BI_EMBED_URL="https://app.powerbi.com/reportEmbed?reportId=00000000-0000-0000-0000-000000000000&groupId=00000000-0000-0000-0000-000000000000"

# Optional: Direct Embed Token for development sandbox verification
# In production, tokens must be retrieved dynamically via authenticated backend endpoint
VITE_POWER_BI_EMBED_TOKEN=""
